NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by `npm run seed`. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Brevo transactional email (server only)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Njörðr
# Display-only exchange rate for ₦ prices
NEXT_PUBLIC_USD_NGN=1500
# Optional: Unsplash API access key for the home hero photos (falls back to product photos if empty)
UNSPLASH_ACCESS_KEY=
